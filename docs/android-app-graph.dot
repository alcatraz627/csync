// csync phone app, as three small graphs. Render each:
//   dot -Tsvg -Gcharset=utf8 docs/android-app-graph.dot -o docs/android-app-graph.svg   (all three on one sheet)
// Read from the code on 2026-10-01 (csync-hub 2.46). Names only; what each page holds is in
// android-app-tree.md, and the model is android-app-model.md.
digraph csync {
  graph [rankdir=TB, newrank=true, fontname="Helvetica", fontsize=11, splines=true, nodesep=0.25, ranksep=0.45,
         bgcolor="#f4f1ea", pad=0.4, labelloc=t, label="csync phone app (2.46)\n"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#5c5346", penwidth=1.1, margin="0.12,0.05"];
  edge  [fontname="Helvetica", fontsize=8, color="#5c5346", arrowsize=0.6];

  // ================= 1. THE MAP: places and their parents. Down = the tap; Back = the same line up. =================
  subgraph cluster_map {
    label="1 · THE MAP   (a line down is the tap that opens a child; Back climbs the same line)"; style="rounded,filled"; fillcolor="#ffffff"; color="#5c5346"; fontsize=12;
    Bar [label="BOTTOM BAR", shape=box, style="filled", fillcolor="#2b2620", fontcolor="#ffffff", color="#2b2620"];
    Home [fillcolor="#fbe9dc"]; Media [fillcolor="#e3eef7"]; Share [fillcolor="#e6f2e4"]; Chat [fillcolor="#f3e8f5"]; More [fillcolor="#f1efe9"];
    Bar -> Home; Bar -> Media; Bar -> Share; Bar -> Chat; Bar -> More;

    Home -> Search [label="search icon"];
    Media -> PiScreen [label="Pi screen row\nmini player"]; Media -> ThisPhone [label="Play on this phone"];
    PiScreen [label="Pi screen"]; ThisPhone [label="This phone"];
    PiScreen -> FullScreen [label="tap the film"]; FullScreen [label="Full screen"];
    Share -> Received [label="Received"]; Share -> FromApp [label="(from Android's share sheet)", style=dotted]; FromApp [label="From another app"];
    Chat -> Conversation [label="row · new"];
    More -> Camera [label="Pi camera"]; Camera -> Captures;
    More -> Notes; Notes -> Note; Notes -> Pin; Note -> NoteEdit [label="edit"]; NoteEdit [label="Note edit"];
    More -> Tools; Tools -> Process [label="Process monitor"]; Process [label="Process monitor"]; Tools -> Widgets;
    More -> Settings; Settings -> Connection;
    More -> Guide [label="Assistant guide"]; Guide [label="Assistant guide"];
    More -> Help [label="Help and about"]; Help [label="Help and about"]; Help -> Design [label="Design system"]; Design [label="Design system"];
    { rank=same; Home; Media; Share; Chat; More; }
  }

  // ================= 2. THE PI SCREEN: what the Pi reports, and what moves it =================
  subgraph cluster_pi {
    label="2 · THE PI SCREEN   (every page that shows the Pi follows this)"; style="rounded,filled"; fillcolor="#e3eef7"; color="#2f6ea3"; fontsize=12;
    node [shape=ellipse, fillcolor="#ffffff"];
    S_idle [label="idle\n(cover)"]; S_loading [label="loading"]; S_playing [label="playing"]; S_paused [label="paused"];
    S_finished [label="finished"]; S_showing [label="showing"]; S_offline [label="offline"];
    S_idle -> S_loading [label="Play"]; S_loading -> S_playing;
    S_playing -> S_paused [label="Pause"]; S_paused -> S_playing [label="Resume"];
    S_playing -> S_finished [label="film ends"]; S_finished -> S_idle;
    S_playing -> S_idle [label="Stop"]; S_paused -> S_idle [label="Stop"];
    S_idle -> S_showing [label="Show"]; S_showing -> S_idle [label="Stop showing"];
    S_showing -> S_showing [label="page turn"]; S_showing -> S_loading [label="Play"]; S_playing -> S_showing [label="Show"];
    S_idle -> S_offline [style=dotted, label="unreachable"]; S_offline -> S_idle [style=dotted];
    Shows [label="Show = picture · text · slideshow · note · document\nPi camera · this phone's screen", shape=note, fillcolor="#ffffff"];
    Plays [label="Play = a drive file · a link · a file from this phone", shape=note, fillcolor="#ffffff"];
    Shows -> S_showing [style=invis]; Plays -> S_loading [style=invis];
  }

  // ================= 3. THE CROSSINGS: moves between places that Back does not reverse =================
  subgraph cluster_cross {
    label="3 · THE CROSSINGS   (single arrows; Back does not reverse these)"; style="rounded,filled"; fillcolor="#ffffff"; color="#8a3c1a"; fontsize=12;
    node [fillcolor="#fff6f0"];
    edge [color="#8a3c1a"];
    X_Home [label="Home"]; X_Search [label="Search"]; X_Item [label="Item sheet\n(any item, anywhere)", style="rounded,dashed,filled"];
    X_Pi [label="Pi screen"]; X_Phone [label="This phone"]; X_Media [label="Media"]; X_Share [label="Share"]; X_Received [label="Received"];
    X_From [label="From another app"]; X_Conv [label="Conversation"]; X_Note [label="Note edit"]; X_Pin [label="Pin"];
    X_Camera [label="Pi camera"]; X_Tools [label="Tools"];
    X_Home -> X_Media [label="Play tile"]; X_Home -> X_Conv [label="Ask tile · Pick up"]; X_Home -> X_Share [label="Send tile"];
    X_Home -> X_Camera [label="Camera tile"]; X_Home -> X_Tools [label="status line"]; X_Home -> X_Pi [label="Pick up"];
    X_Search -> X_Item [label="media result"]; X_Search -> X_Conv [label="chat result"]; X_Search -> X_Received [label="file result"];
    X_Item -> X_Pi [label="Play / Show on Pi"]; X_Item -> X_Phone [label="Play here"]; X_Item -> X_From [label="Send to a device"];
    X_Item -> X_Conv [label="Send to a conversation"]; X_Item -> X_Note [label="Add to a note"]; X_Item -> X_Pin [label="Save as a pin"];
    X_From -> X_Pi [label="Play / Show"]; X_From -> X_Conv; X_From -> X_Note; X_From -> X_Pin;
    X_Pi -> X_From [label="A file from this phone"]; X_Pi -> X_Media [label="Browse Media"];
    Outside [label="OUTSIDE: shortcuts · widgets · tiles · share menu · notifications", shape=note, fillcolor="#ebebeb"];
    Outside -> X_Conv [style=dotted, label="New chat · Ask the Pi · reply"]; Outside -> X_Share [style=dotted, label="Send"];
    Outside -> X_Camera [style=dotted, label="Camera · glance · tile"]; Outside -> X_Pi [style=dotted, label="Media remote · Send to Pi screen"];
    Outside -> X_Tools [style=dotted, label="Pi status"]; Outside -> X_From [style=dotted, label="csync · last device"];
    Outside -> X_Phone [style=dotted, label="playback"];
  }
}
